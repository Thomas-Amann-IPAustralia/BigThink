# Raw API payloads. Large, reproducible from the run id, and regenerated by
# every collection run. Keep them locally for debugging; do not commit them.
# If you need them durable across runners, that is what Cloudflare R2 is for
# (see BasicInfraSuggestion.md) — not the git history.
data/raw/

# DuckDB database and its write-ahead log. Rebuildable from data/raw plus a
# re-run. Committing it would put a multi-hundred-megabyte binary into every
# clone, and DuckDB files do not diff.
data/bigthink.duckdb
data/bigthink.duckdb.wal
data/*.duckdb
data/*.duckdb.wal

# Local run logs
data/logs_*.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
